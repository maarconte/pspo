rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // Helper Functions
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isDev() {
      return hasRole('dev');
    }

    function isAdmin() {
      return hasRole('admin') || isDev();
    }

    function isClient() {
      return hasRole('client') || isAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ========================================
    // Collections Rules
    // ========================================

    // Collection users
    match /users/{userId} {
      // Lecture : l'utilisateur peut lire son propre profil, les devs peuvent tout lire
      allow read: if isOwner(userId) || isDev();

      // Création : automatique via Cloud Function
      allow create: if false;

      // Mise à jour : seuls les devs peuvent modifier (via Cloud Function)
      allow update: if isDev();

      // Suppression : seuls les devs
      allow delete: if isDev();

      // Sessions de quiz de l'utilisateur
      match /quizSessions/{sessionId} {
        // L'utilisateur peut lire/écrire ses propres sessions
        allow read, write: if isOwner(userId);

        // Les devs peuvent tout voir
        allow read: if isDev();
      }

      // Statistiques de l'utilisateur
      match /statistics/{docId} {
        // L'utilisateur peut lire/écrire ses propres stats
        allow read, write: if isOwner(userId);

        // Les devs peuvent tout voir
        allow read: if isDev();
      }
    }

    // Collection questions
    match /questions/{questionId} {
      // Lecture : tout le monde peut lire (pour le quiz)
      allow read: if true;

      // Modification : admin et dev peuvent tout faire
      // Les utilisateurs (identifiés ou non) peuvent seulement signaler une erreur (flagging)
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['comments', 'isFlagged', 'updatedAt'])
      );

      // Création, suppression : admin et dev uniquement
      allow create, delete: if isAdmin();
    }

    // Collection questions_dev (bac à sable utilisé par `npm run dev`,
    // notamment pour tester les imports CSV sans toucher aux questions
    // publiées en prod). Mêmes règles que la collection questions.
    match /questions_dev/{questionId} {
      allow read: if true;

      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['comments', 'isFlagged', 'updatedAt'])
      );

      allow create, delete: if isAdmin();
    }

    // Collection categories (si vous en avez)
    match /categories/{categoryId} {
      // Lecture : tout le monde
      allow read: if true;

      // Écriture : admin et dev uniquement
      allow write: if isAdmin();
    }

    // Collection modules
    match /modules/{moduleId} {
      // Lecture : tout le monde peut lire (pour le choix du quiz)
      allow read: if true;

      // Modification : admin et dev peuvent tout faire.
      // Un utilisateur authentifié peut seulement incrémenter le compteur
      // de quiz terminés (+1 exactement), déclenché en fin de quiz.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedCount']) &&
        request.resource.data.completedCount == resource.data.completedCount + 1
      );

      // Création, suppression : admin et dev uniquement
      allow create, delete: if isAdmin();
    }

    // Collection modules_dev (bac à sable utilisé par `npm run dev`,
    // pour ne pas toucher aux modules publiés en prod). Mêmes règles que modules.
    match /modules_dev/{moduleId} {
      // Lecture : tout le monde peut lire (pour le choix du quiz)
      allow read: if true;

      // Modification : admin et dev peuvent tout faire.
      // Un utilisateur authentifié peut seulement incrémenter le compteur
      // de quiz terminés (+1 exactement), déclenché en fin de quiz.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedCount']) &&
        request.resource.data.completedCount == resource.data.completedCount + 1
      );

      // Création, suppression : admin et dev uniquement
      allow create, delete: if isAdmin();
    }

    // Collections roti / roti_dev : notes ROTI (Return On Time Invested).
    // Création ouverte aux visiteurs comme aux utilisateurs connectés, avec
    // validation stricte du contenu ; lecture et suppression réservées aux admins.
    function isValidRoti() {
      let d = request.resource.data;
      return d.keys().hasOnly(['score', 'comment', 'source', 'moduleId', 'userId', 'createdAt'])
        && d.keys().hasAll(['score', 'source', 'userId', 'createdAt'])
        && d.score is int && d.score >= 1 && d.score <= 5
        && d.source in ['quiz', 'page']
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 1000 && d.score <= 3))
        && (!('moduleId' in d) || d.moduleId == null || d.moduleId is string)
        && (d.userId == null || d.userId == request.auth.uid)
        && d.createdAt == request.time;
    }

    // Limite d'une note ROTI par mois : un utilisateur connecté (non admin) doit
    // écrire dans le document `{uid}_{année}-{mois}` (mois UTC, sans zéro devant),
    // ce qui rend toute seconde écriture du même mois impossible (update interdit).
    // Les admins et devs écrivent sans limite (tests). Les visiteurs anonymes ne
    // peuvent être limités que côté client.
    function canCreateRoti(entryId) {
      return isValidRoti() && (
        isAdmin()
        || (isAuthenticated()
            && request.resource.data.userId == request.auth.uid
            && entryId == request.auth.uid + '_' + string(request.time.year()) + '-' + string(request.time.month()))
        || (!isAuthenticated() && request.resource.data.userId == null)
      );
    }

    match /roti/{entryId} {
      allow create: if canCreateRoti(entryId);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /roti_dev/{entryId} {
      allow create: if canCreateRoti(entryId);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Collection tickets
    match /tickets/{ticketId} {
      // Les clients authentifiés peuvent lire (pour voir leurs tickets ou liste partagée)
      allow read: if isAuthenticated();
      // Création ouverte aux utilisateurs
      allow create: if isAuthenticated();
      // Maj pour les administrateurs ou devs, ou l'auteur
      allow update: if isAuthenticated();
      // Seuls admins/devs, ou auteur
      allow delete: if isAuthenticated();

      // Sous-collection messages
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
